import math as m
import matplotlib.pyplot as plt
import numpy as np

animation   = True #Pt kan den kun animere ELLER tegne
plot        = False
N           = 10000

m1  = 1 # kg
m2  = 1 # kg 
L1  = 1 # m 
L2  = 1 # m 
vv1 = 0 
vv2 = 0 

g   = 9.82 # m/s^2

theta1 = 0.5*m.pi
theta2 = 0.5*m.pi

x1    = 1 # m 
y1    = -L1 * m.cos(theta1) # m 
x2    = 2 # m 
y2    = 0 # m 
x2Old = 0 
y2Old = 0

x1s = np.zeros(N)
y1s = np.zeros(N)
x2s = np.zeros(N)
y2s = np.zeros(N) 

ts      = np.zeros(N)
av1s    = np.zeros(N)
av2s    = np.zeros(N)
vv1s    = np.zeros(N) 
vv2s    = np.zeros(N)
theta1s = np.zeros(N)
theta2s = np.zeros(N)

eMekList = np.zeros(N)

dt = 0.001 # s
t  = 0    # s

# Ligninger der udregner angular momentum fra MIT https://web.mit.edu/jorloff/www/chaosTalk/double-pendulum/double-pendulum-en.html 

def get_accelerations(g, m1, m2, theta1, theta2, L1, L2, vv1, vv2): 
    
    foersteLed = - g * (2*m1 + m2) * m.sin(theta1)
    andetLed   = - m2 * g * m.sin(theta1 - 2*theta2)
    tredjeLed  = -2*m.sin(theta1 - theta2) * m2 * (vv2**2 * L2 + vv1**2*L1*m.cos(theta1 - theta2))
    
    taeller    = foersteLed + andetLed + tredjeLed
    naevner    = L1 * (2*m1 + m2 - m2*m.cos(2*theta1 - 2*theta2))

    foersteAccelleration = taeller / naevner

    foersteLed = 2 * m.sin(theta1 - theta2)
    andetLed   = (vv1**2 * L1*(m1 + m2) + g*(m1 + m2) * m.cos(theta1))
    tredjeLed  = vv2**2 * L2 * m2 * m.cos(theta1 - theta2)
    taeller    = foersteLed * (andetLed + tredjeLed)

    naevner    = L2 * (2*m1 + m2 - m2*m.cos(2*theta1 - 2*theta2))

    andenAcceleration = taeller / naevner

    return(foersteAccelleration, andenAcceleration)

def get_mekanisk_energi(m1, m2, vv1, y1, y2, x2, g, L1, x2Old, y2Old):    
    ePot1 = m1 * g * (y1 + 10)
    eKin1 = 1/2 * m1 * (L1*vv1)**2
    eMek1 = abs(ePot1) + abs(eKin1)

    # ½ (m₁ + m₂) L₁² ω₁² + ½ m₂ L₂² ω₂² + m₂ L₁ L₂ ω₁ ω₂ cos(θ₁ − θ₂)
    foersteLed = 1/2 * (m1 + m2) * L1**2 * vv1**2
    andetLed   = 1/2 * m2 * L2**2 * vv2**2 
    tredjeLed  = m2 * L1 * L2 * vv1 * vv2 * m.cos(theta1 - theta2)
    eKin2      = foersteLed + andetLed + tredjeLed

    # −(m₁ + m₂) g L₁ cos θ₁ − m₂ g L₂ cos θ₂
    foersteLed = -(m1 + m2) * g * L1 * m.cos(theta1)
    andetLed   = - m2 * g * L2 * m.cos(theta2)
    ePot2      = foersteLed + andetLed

    eMek2 = ePot2 + eKin2

    eMekTot = eMek1 + eMek2

    return(eMekTot)

for i in range (N): 
    av1, av2 = get_accelerations(g, m1, m2, theta1, theta2, L1, L2, vv1, vv2)

    vv1 += av1 * dt     # r/s
    vv2 += av2 * dt     # r/s

    theta1 += vv1 * dt  # r
    theta2 += vv2 * dt  # r

    

    # Vinkler omregnes til afstande via trigonometri
    y1 = L1 * m.sin(theta1)
    x1 = L1 * m.cos(theta1)

    y2 = y1 - L2 * m.sin(theta2) # kun theta 2, idet MITs vinkler er absolutte
    x2 = x1 + L2 * m.cos(theta2)

    # Mekanisk energi
    eMek = get_mekanisk_energi(m1, m2, vv1, y1, y2, x2, g, L1, x2Old, y2Old)

    t += dt 
    x2Old = x2
    y2Old = y2

    # Arrays til animation
    y1s[i] = y1
    x1s[i] = x1

    y2s[i] = y2
    x2s[i] = x2

    # lister til grafer
    ts[i] = t
    av1s[i] = av1
    av2s[i] = av2
    vv1s[i] = vv1
    vv2s[i] = vv2
    theta1s[i] = theta1
    theta2s[i] = theta2

    # Mekanisk energi
    eMekList[i] = eMek

# Plot forskellige værdier. De øverste grafer er det øverste pendul og omvendt.
if plot: 
        
    plt.figure(1)

    plt.subplot(231)
    plt.plot(ts, av1s,'b-',markersize=1)
    plt.xlabel("Time / [s]")
    plt.ylabel("Angular momentum / [r/s^2]")
    plt.grid(True)

    plt.subplot(232)
    plt.plot(ts,vv1s,'b-',markersize=1)
    plt.xlabel("Time / [s]")
    plt.ylabel("Angular speed / [r/s]")
    plt.grid(True)

    plt.subplot(233)
    plt.plot(ts,theta1s,'b-',markersize=1)
    plt.xlabel("Time / [s]")
    plt.ylabel("Radians / [r]")
    plt.grid(True)

    # Den nederste række er det nederste pendul. 
        
    plt.subplot(234)
    plt.plot(ts, av2s,'b-',markersize=1)
    plt.xlabel("Time / [s]")
    plt.ylabel("Angular momentum / [r/s^2]")
    plt.grid(True)

    plt.subplot(235)
    plt.plot(ts,vv2s,'b-',markersize=1)
    plt.xlabel("Time / [s]")
    plt.ylabel("Angular speed / [r/s]")
    plt.grid(True)

    plt.subplot(236)
    plt.plot(ts,theta2s,'b-',markersize=1)
    plt.xlabel("Time / [s]")
    plt.ylabel("Radians / [r]")
    plt.grid(True)

    plt.show()

# Animation 
if animation: 

    fig = plt.figure(1 if plot==False else 2)
    ax = fig.add_subplot()
    ax.set_aspect("equal") 


    for i in range(N): 
        if i % 10 == 0: 
            plt.clf()
            plt.axis([-2*L1,2*L1,-2*L2,2*L2],)
            plt.plot([x1s[i], 0], [y1s[i], 0], markersize=10) 
            plt.plot([x2s[i], x1s[i]], [y2s[i], y1s[i]], markersize=10)
            plt.plot(x2s[:i], y2s[:i], 'r-') 
            plt.pause(dt)
            print(f"Det første pendulshastighed er: {vv1s[i]}")
            print(f"Det andet penduls hastighed er: {vv2s[i]}")
            print(f"Det første penduls vinkel er: {theta1s[i]}")
            print(f"Det andet penduls vinkel er: {theta2s[i]}")
            print(f"Tiden er: {ts[i]}")
            print("---" * 10)       

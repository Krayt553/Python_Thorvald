import math as m
import matplotlib.pyplot as plt
import numpy as np

animation   = False #Pt kan den kun animere ELLER tegne
plot        = True
N           = 10000

m1  = 1 # kg
m2  = 1 # kg 
L1  = 1 # m 
L2  = 1 # m 
vv1 = 0 
vv2 = 0 

g  = -9.82 # m/s^2

theta1 = 0.5*m.pi
theta2 = 0

x1 = 1 # m 
y1 = 0 # m 
x2 = 2 # m 
y2 = 0 # m 
x2Old = 0 
y2Old = 0

x1s = np.array([None] * N)
y1s = np.array([None] * N)
x2s = np.array([None] * N)
y2s = np.array([None] * N) 

ts      = np.array([None] * N)
av1s    = np.array([None] * N)
av2s    = np.array([None] * N)
vv1s    = np.array([None] * N) 
vv2s    = np.array([None] * N)
theta1s = np.array([None] * N)
theta2s = np.array([None] * N)

eMekList = []

dt = 0.001 # s
t  = 0    # s

# Ligninger der udregner angular momentum fra MIT https://web.mit.edu/jorloff/www/chaosTalk/double-pendulum/double-pendulum-en.html 

def get_acceleration_1(g, m1, m2, theta1, theta2, L1, L2, vv1, vv2): 
    
    foersteLed = - g * (2*m1 + m2) * m.sin(theta1)
    andetLed   = - m2 * g * m.sin(theta1 - 2*theta2)
    tredjeLed  = -2*m.sin(theta1 - theta2) * m2 * (vv2**2 * L2 + vv1**2*L1*m.cos(theta1 - theta2))
    taeller    = foersteLed + andetLed + tredjeLed

    naevner    = L1 * (2*m1 + m2 - m2*m.cos(2*theta1 - 2*theta2))

    broek = taeller / naevner

    return(broek)

def get_acceleration_2(g, m1, m2, theta1, theta2, L1, L2, vv1, vv2):
    foersteLed = 2 * m.sin(theta1 - theta2)
    andetLed   = (vv1**2 * L1*(m1 + m2) + g*(m1 + m2) * m.cos(theta1))
    tredjeLed  = vv2**2 * L2 * m2 * m.cos(theta1 - theta2)
    taeller    = foersteLed * (andetLed + tredjeLed)

    naevner    = L2 * (2*m1 + m2 - m2*m.cos(2*theta1 - 2*theta2))

    broek = taeller / naevner

    return(broek)

def get_mekanisk_energi(m1, m2, vv1, y1, y2, x2, g, L1, x2Old, y2Old):    
    ePot1 = m1 * g * (y1 + 10)
    eKin1 = 1/2 * m1 * (L1*vv1)**2
    eMek1 = abs(ePot1) + abs(eKin1)

    dx2 = abs(x2) - abs(x2Old)
    dy2 = abs(y2) - abs(y2Old)
    vx2 = dx2 / dt
    vy2 = dy2 / dt
    absV2 = (vx2**2 + vy2**2)**(1/2)
    
    ePot2 = m2 * g * (y2 + 20)
    eKin2 = 1/2 * m2 * absV2**2
    eMek2 = abs(ePot2) + abs(eKin2)

    eMekTot = eMek1 + eMek2

    return(eMekTot)

for i in range (N): 
    av1 = get_acceleration_1(g, m1, m2, theta1, theta2, L1, L2, vv1, vv2)
    av2 = get_acceleration_2(g, m1, m2, theta1, theta2, L1, L2, vv1, vv2)

    vv1 += av1 * dt     # r/s
    vv2 += av2 * dt     # r/s

    theta1 += vv1 * dt  # r
    theta2 += vv2 * dt  # r

    

    # Vinkler omregnes til afstande via trigonometri
    y1 = L1 * m.cos(theta1)
    x1 = L1 * m.sin(theta1)

    y2 = L2 * m.cos(theta2 + theta1) + y1
    x2 = L2 * m.sin(theta2 + theta1) + x1

    # Mekanisk energi
    eMek = get_mekanisk_energi(m1, m2, vv1, y1, y2, x2, g, L1, x2Old, y2Old)

    # Arrays til animation
    y1s[i] = y1
    x1s[i] = x1

    y2s[i] = y2
    x2s[i] = x2

    # lister til grafer
    ts[i] = t
    av1s[i] = av1
    av2s[i] = av2
    vv1s[i] = vv1
    vv2s[i] = vv2
    theta1s[i] = theta1
    theta2s[i] = theta2

    t += dt 
    x2Old = x2
    y2Old = y2

# Plot forskellige værdier. De øverste grafer er det øverste pendul og omvendt.
if plot: 
        
    plt.figure(1)

    plt.subplot(231)
    plt.plot(ts, av1s,'b-',markersize=1)
    plt.xlabel("Time / [s]")
    plt.ylabel("Angular momentum / [r/s^2]")
    plt.grid(True)

    plt.subplot(232)
    plt.plot(ts,vv1s,'b-',markersize=1)
    plt.xlabel("Time / [s]")
    plt.ylabel("Angular speed / [r/s]")
    plt.grid(True)

    plt.subplot(233)
    plt.plot(ts,theta1s,'b-',markersize=1)
    plt.xlabel("Time / [s]")
    plt.ylabel("Radians / [r]")
    plt.grid(True)

    # Den nederste række er det nederste pendul. 
        
    plt.subplot(234)
    plt.plot(ts, av2s,'b-',markersize=1)
    plt.xlabel("Time / [s]")
    plt.ylabel("Angular momentum / [r/s^2]")
    plt.grid(True)

    plt.subplot(235)
    plt.plot(ts,vv2s,'b-',markersize=1)
    plt.xlabel("Time / [s]")
    plt.ylabel("Angular speed / [r/s]")
    plt.grid(True)

    plt.subplot(236)
    plt.plot(ts,theta2s,'b-',markersize=1)
    plt.xlabel("Time / [s]")
    plt.ylabel("Radians / [r]")
    plt.grid(True)

    plt.show()

# Animation 
if animation: 

    fig = plt.figure(1 if plot==False else 2)
    ax = fig.add_subplot()
    ax.set_aspect("equal") 


    for i in range(N): 
        if i % 10 == 0: 
            plt.clf()
            plt.axis([-2*L1,2*L1,-2*L2,2*L2],)
            plt.plot([x1s[i], 0], [y1s[i], 0], markersize=10) 
            plt.plot([x2s[i], x1s[i]], [y2s[i], y1s[i]], markersize=10)
            plt.plot(x2s[:i], y2s[:i], 'r-') 
            plt.pause(dt)
            print(f"Det første pendulshastighed er: {vv1s[i]}")
            print(f"Det andet penduls hastighed er: {vv2s[i]}")
            print(f"Det første penduls vinkel er: {theta1s[i]}")
            print(f"Det andet penduls vinkel er: {theta2s[i]}")
            print(f"Tiden er: {ts[i]}")
            print("---" * 10)       

import math
import matplotlib.pyplot as plt

r = 10      # m 
g = -9.82   # m/s^2 
m = 1       # kg
Fg = g * m  # kg m/s^2

vy = 0      # m/s
vx = 0      # m/s
vTotal = 0  # m/s

dt = 0.01  # s
t = 0       # s

xPendul = 5 # mellem -r og +r
yPendul = -(r**2 - xPendul**2)**(1/2) 
xStart  = 0
yStart  = 0

done = False

def get_vinkel(xPendul):
    brøk = xPendul / r
    vinkelPendul = math.degrees(math.asin(brøk))
    
    return(vinkelPendul)

def get_afstand(yPendul, xPendul, yStart, xStart):
    dy = yPendul - yStart
    dx = xPendul - xStart
    hypotenuse = (dy**2 + dx**2)**(1/2)
    
    return(hypotenuse)

def get_snorkraft(): 
    return()


for i in range (100000): 
    vinkel = get_vinkel(xPendul)

    gProj = Fg * math.degrees(math.cos(vinkel)) 
    Fc = -((m * vTotal**2) / r)

    Fres = gProj + Fc
    Fs   = - Fres

    Fsy = Fs * math.degrees(math.cos(vinkel))
    Fsx = Fs * math.degrees(math.sin(vinkel))

    print(f"kraften nedad: {Fsy}")

    asy = (Fsy + Fg) / m 
    asx = Fsx / m 

    print(f"accelerationen nedad: {asy}")

    vy      += asy * dt
    vx      += asx * dt

    print(f"hastigheden nedad: {vy}")
    print("---"*10)

    vTotal = (vy**2 + vx**2)**(1/2)

    yPendul += vy * dt
    xPendul += vx * dt

    yStorage = [yStart, yPendul]
    xStorage = [xStart, xPendul]

    t += dt

    plt.clf()
    plt.axis([-r,r,-r,r])
    plt.plot(xStorage, yStorage, markersize=10) 
    plt.plot([xPendul, xPendul+0.000001], [yPendul, yPendul+0.000001], color='b', marker='o', markersize=20) 
    plt.pause(dt)

import math as m
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation
import numpy as np


animation = True
plot      = False
N         = 1000

m1  = 1 # kg
m2  = 1 # kg 
L1  = 1 # m 
L2  = 1 # m 
vv1 = 0 
vv2 = 0 

g  = -9.82 # m/s^2

theta1 = 0.5*m.pi
theta2 = - 1.5*m.pi

x1 = 0 # m 
y1 = 0 # m 
x2 = 0 # m 
y2 = 0 # m 

dt = 0.01 # s
t  = 0    # s

x1s=[]
y1s=[]
x2s=[]
y2s=[]

ts      = np.array([None] * N)
av1s    = np.array([None] * N)
av2s    = np.array([None] * N)
vv1s    = np.array([None] * N) 
vv2s    = np.array([None] * N)
theta1s = np.array([None] * N)
theta2s = np.array([None] * N)

# Ligninger der udregner angular momentum fra MIT https://web.mit.edu/jorloff/www/chaosTalk/double-pendulum/double-pendulum-en.html 

def get_acceleration_1(g, m1, m2, theta1, theta2, L1, L2, vv1, vv2): 
    
    foersteLed = - g * (2*m1 + m2) * m.sin(theta1)
    andetLed  = - m2 * g * m.sin(theta1 - 2*theta2)
    tredjeLed = -2*m.sin(theta1 - theta2) * m2 * (vv2**2 * L2 + vv1**2*L1*m.cos(theta1 - theta2))
    taeller    = foersteLed + andetLed + tredjeLed

    naevner    = L1 * (2*m1 + m2 - m2*m.cos(2*theta1 - 2*theta2))

    broek = taeller / naevner

    return(broek)

def get_acceleration_2(g, m1, m2, theta1, theta2, L1, L2, vv1, vv2):
    foersteLed = 2 * m.sin(theta1 - theta2)
    andetLed   = (vv1**2 * L1*(m1 + m2) + g*(m1 + m2)) * m.cos(theta1)
    tredjeLed  = vv2**2 * L2 * m2 * m.cos(theta1 - theta2)
    taeller    = foersteLed * (andetLed + tredjeLed)

    naevner    = L2 * (2*m1 + m2 - m2*m.cos(2*theta1 - 2*theta2))

    broek = taeller / naevner

    return(broek)

for i in range (N): 
    av1 = get_acceleration_1(g, m1, m2, theta1, theta2, L1, L2, vv1, vv2)
    av2 = get_acceleration_2(g, m1, m2, theta1, theta2, L1, L2, vv1, vv2)

    vv1 += av1 * dt     # r/s
    vv2 += av2 * dt     # r/s

    theta1 += vv1 * dt  # r
    theta2 += vv2 * dt  # r

    # Vinkler omregnes til afstande via trigonometri
    y1 = L1 * m.cos(theta1)
    x1 = L1 * m.sin(theta1)

    y2 = L2 * m.cos(theta2) + y1
    x2 = L2 * m.sin(theta2) + x1

    # lister til grafer
    ts[i] = t
    av1s[i] = av1
    av2s[i] = av2
    vv1s[i] = vv1
    vv2s[i] = vv2
    theta1s[i] = theta1
    theta2s[i] = theta2

    t += dt
    x1s.append(x1)
    y1s.append(y1)
    x2s.append(x2)
    y2s.append(y2)

    # Animation 
    if animation: 
        plt.figure(1)

        plt.clf()
        plt.axis([-2*L1,2*L1,-2*L2,2*L2])
        plt.plot([x1, 0], [y1, 0], markersize=10) 
        plt.plot([x2, x1], [y2, y1], markersize=10)
        plt.plot(x2s, y2s, 'r-') 
        plt.pause(dt)

    # Plot forskellige værdier. De øverste grafer er det øverste pendul og omvendt.
    if plot: 
        plt.figure(1 if plot==False else 2)

        plt.subplot(231)
        plt.plot(ts, av1s,'b-',markersize=1)
        plt.xlabel("Time / [s]")
        plt.ylabel("Angular momentum / [r/s^2]")
        plt.grid(True)

        plt.subplot(232)
        plt.plot(ts,vv1s,'b-',markersize=1)
        plt.xlabel("Time / [s]")
        plt.ylabel("Angular speed / [r/s]")
        plt.grid(True)

        plt.subplot(233)
        plt.plot(ts,theta1s,'b-',markersize=1)
        plt.xlabel("Time / [s]")
        plt.ylabel("Radians / [r]")
        plt.grid(True)

        # Den nederste række er det nederste pendul. 
        
        plt.subplot(234)
        plt.plot(ts, av2s,'b-',markersize=1)
        plt.xlabel("Time / [s]")
        plt.ylabel("Angular momentum / [r/s^2]")
        plt.grid(True)

        plt.subplot(235)
        plt.plot(ts,vv2s,'b-',markersize=1)
        plt.xlabel("Time / [s]")
        plt.ylabel("Angular speed / [r/s]")
        plt.grid(True)

        plt.subplot(236)
        plt.plot(ts,theta2s,'b-',markersize=1)
        plt.xlabel("Time / [s]")
        plt.ylabel("Radians / [r]")
        plt.grid(True)





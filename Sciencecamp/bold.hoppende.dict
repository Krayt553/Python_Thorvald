import numpy as np
import matplotlib.pyplot as plt
import matplotlib.animation as animation

global x, y, vx, vy, ax, ay, t, g, E_mek

# -------------------------
# Parametre
# -------------------------
N           = 2         # Antal bolde
Draw_track  = True      # Der tegnes en streg efter bolden
g           = -9.8      # Tyngdeaccelleratioen
dt          = 0.005     # Tidsskridtet
t           = 0         # Starttiden


# Definer numpy arrays til at håndtere boldenes positioner, masser, hastigheder m.m.

class Ball: 
    def __init__(self, x, y, vx, vy, vxOld, vyOld, m, r, ax, ay, colors):
        self.x       = x         # x-position (m)
        self.y       = y         # y-position (m)
        self.vx      = vx        # hastighed i x-aksens retning (m/s)
        self.vy      = vy        # hastighed i y-aksens retning (m/s)
        self.vxOld   = vxOld     # hastighed i x-aksens retning (m/s)
        self.vyOld   = vyOld     # hastighed i y-aksens retning (m/s)
        self.m       = m         # masse (kg)
        self.r       = r         # radius (m)
        self.ax      = ax        # accelleration i x-aksens retning
        self.ay      = ay        # accelleration i y-aksens retning


xmin, xmax = 0, 25   #Størrelsen af kassen
ymin, ymax = 0, 25

# -------------------------
# Bold-parametre (arrays)
# -------------------------

for i in range(N): 
    x = np.arange(xmin, xmax, 1)
    y = np.arange(ymin, ymax, 1)
    vx = np.arange(-5, 5, 1)
    vy = np.arange(-5, 5, 1)
    m = np.arange(1, 10, 1)
    r = np.arange(0.1, 0.5, 0.1)
    ax = 0
    ay = g


# -------------------------
# Historik til spor -  
# -------------------------
x_hist = [[] for _ in range(N+1)]
y_hist = [[] for _ in range(N+1)]

# -------------------------
# Lav en figur hvor animationen skal vises i
# -------------------------
fig, axes = plt.subplots()
axes.set_xlim(xmin, xmax)
axes.set_ylim(ymin, ymax)
axes.set_aspect('equal')

balls = []
tracks = []

for i in range(N+1):
    ball = plt.Circle((x[i], y[i]), r[i], color=colors[i]) # Define size, color, and position of balls
    axes.add_patch(ball)
    balls.append(ball)
    track, = axes.plot([], [], color=colors[i], lw=1)
    tracks.append(track)

# -------------------------
# Opdateringsfunktion

#HER SKAL I INDSÆTTE FYSIKKEN!!!!

# -------------------------
def update(frame):
    global x, y, vx, vy, az, ay, t

    t = t+dt

    for i in range(N+1):
        vx_old[i] = vx[i] # Save the x-velocity from the previous time step
        vy_old[i] = vy[i] # Save the y-velocity from the previous time step

        vx[i] = vx[i] + ax[i]*dt
        vy[i] = vy[i] + ay[i]*dt
        
        x[i] = x[i] + vx[i]*dt
        y[i] = y[i] + vy[i]*dt
        
        # Vægkollisioner
        if y[i] < ymin:
            vy[i] = - vy[i]
            y[i]  = - y[i]

        if x[i] > xmax:
            vx[i] = - vx[i]
            x[i]  = 2*xmax - x[i]

        if x[i] < xmin:
            vx[i] = - vx[i]
            x[i]  = 2*xmin + x[i]

        # Gem historik
        x_hist[i].append(x[i])
        y_hist[i].append(y[i])

        # Opdater grafik
        balls[i].center = (x[i], y[i])
        tracks[i].set_data(x_hist[i], y_hist[i])

    if Draw_track:
        return balls + tracks
    else:
        return balls

# -------------------------
# Animation
# -------------------------
ani = animation.FuncAnimation(
    fig, update, frames=6, interval=0, blit=True
)

plt.show()